# =============================================================================
# nowtb-next Environment Variables
# Copy this to .env.local and fill in real values
# =============================================================================

# Site URL (used for OG tags, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://nowtb.com

# Contact info (displayed in UI)
NEXT_PUBLIC_CONTACT_PHONE=(813) 733-7907
NEXT_PUBLIC_CONTACT_EMAIL=barrett@nowtb.com

# Bridge Interactive / Stellar MLS API
BRIDGE_API_BASE=https://api.bridgedataoutput.com/api/v2
BRIDGE_SERVER_TOKEN=your_server_token_here
BRIDGE_BROWSER_TOKEN=your_browser_token_here
BRIDGE_CLIENT_ID=your_client_id_here
BRIDGE_CLIENT_SECRET=your_client_secret_here
BRIDGE_DATASET=stellar

# Cloudflare Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Follow Up Boss CRM
FUB_API_KEY=your_fub_api_key_here

# Resend (alert emails to Barrett + auto-responder to leads)
# If not set, email is skipped silently — n8n handles alerts instead
RESEND_API_KEY=re_your_api_key_here

# n8n Automation Webhooks
N8N_WEBHOOK_BASE=https://your-n8n-instance.com/webhook

# Supabase (auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
